// Arrematto — modelo de dados mínimo do MVP. Centavos inteiros; timestamps em UTC.
// Regras de negócio (taxas, escrow, bundling) vivem em packages/domain; aqui só persistência.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Country { BR MX }
enum UserRole { BUYER SELLER ADMIN }
enum KycStatus { PENDING APPROVED REJECTED }
enum ShowStatus { SCHEDULED LIVE ENDED CANCELLED }
enum ListingType { AUCTION BUY_IT_NOW }
enum ListingStatus { DRAFT ACTIVE SOLD UNSOLD ARCHIVED }
enum OrderStatus { PENDING_PAYMENT PAID CANCELLED SHIPPED DELIVERED RETURN_REQUESTED REFUNDED COMPLETED }
enum PaymentMethod { PIX CARD }
enum PaymentStatus { PENDING AUTHORIZED PAID FAILED REFUNDED }
enum ShipmentStatus { LABEL_CREATED SCANNED IN_TRANSIT DELIVERED LOST }
enum LedgerType { ITEM SHIPPING COMMISSION SERVICE_FEE CANCELLATION_FEE REFUND PAYOUT ADJUSTMENT }

model User {
  id          String   @id @default(cuid())
  authId      String   @unique // id do Supabase Auth
  email       String   @unique
  phone       String?
  name        String
  role        UserRole @default(BUYER)
  country     Country  @default(BR)
  createdAt   DateTime @default(now())
  seller      SellerProfile?
  addresses   Address[]
  bids        Bid[]
  orders      Order[]  @relation("buyerOrders")
  spendLimitCents Int?  // Account Controls: limite mensal opcional com PIN
  events      Event[]
}

model Address {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  label     String @default("casa")
  street    String
  number    String
  complement String?
  district  String
  city      String
  state     String
  zip       String
  country   Country @default(BR)
  isDefault Boolean @default(false)
}

model SellerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  legalName      String
  taxId          String    @unique // CNPJ (BR) ou RFC (MX)
  kycStatus      KycStatus @default(PENDING)
  kycProvider    String?   // idwall | unico | stripe
  kycRef         String?
  originAddressId String?
  // Account Health (janela móvel de 12 semanas; recalculada por job)
  onTimeScanRate      Float @default(1)
  cancellationFreeRate Float @default(1)
  refundFreeRate      Float @default(1)
  sales28dCents       Int   @default(0) // define o tier de comissão
  priorCancellations  Int   @default(0)
  payoutAccountRef    String? // id do recebedor no Pagar.me/Asaas
  anvisaCompliant     Boolean @default(false) // sellers de cosméticos: declaração + nº de processo por SKU
  createdAt      DateTime @default(now())
  shows          Show[]
  listings       Listing[]
  orders         Order[]  @relation("sellerOrders")
  ledger         LedgerEntry[]
}

model Show {
  id          String     @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  title       String
  category    String
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  status      ShowStatus @default(SCHEDULED)
  isPrivate   Boolean    @default(false)
  livekitRoom String?    // nome da sala; token emitido pela API por participante
  thumbnailUrl String?
  listings    Listing[]
  orders      Order[]
  createdAt   DateTime   @default(now())
}

model Listing {
  id            String        @id @default(cuid())
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id])
  showId        String?
  show          Show?         @relation(fields: [showId], references: [id])
  type          ListingType
  status        ListingStatus @default(DRAFT)
  title         String
  description   String?
  sku           String?
  category      String        // taxonomia própria (ex.: beauty.hair)
  priceCents    Int           // BIN: preço; AUCTION: lance inicial
  quantity      Int           @default(1)
  weightGrams   Int
  anvisaProcess String?       // obrigatório em cosméticos
  imageUrls     String[]
  offerable     Boolean       @default(true)
  auctionSnapshot Json?       // estado final do leilão copiado do Redis ao fechar
  bids          Bid[]
  orderItems    OrderItem[]
  createdAt     DateTime      @default(now())
}

model Bid {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  maxCents   Int
  priceCents Int
  placedAt   DateTime
  @@index([listingId, placedAt])
}

model Order {
  id          String      @id @default(cuid())
  buyerId     String
  buyer       User        @relation("buyerOrders", fields: [buyerId], references: [id])
  sellerId    String
  seller      SellerProfile @relation("sellerOrders", fields: [sellerId], references: [id])
  showId      String?
  show        Show?       @relation(fields: [showId], references: [id])
  status      OrderStatus @default(PENDING_PAYMENT)
  itemsCents  Int
  shippingCents Int
  taxCents    Int         @default(0)
  commissionCents Int
  serviceFeeCents Int
  totalCents  Int
  escrowReleaseAt DateTime? // D+7 após entrega (CDC art. 49)
  withdrawalDeadline DateTime? // prazo de arrependimento
  nfeKey      String?     // chave da NF-e emitida pelo seller via Focus NFe
  items       OrderItem[]
  payment     Payment?
  shipment    Shipment?
  ledger      LedgerEntry[]
  createdAt   DateTime    @default(now())
  @@index([buyerId, status])
  @@index([sellerId, status])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id])
  priceCents Int
  shippingAllocCents Int // alocação do bundling
  quantity   Int     @default(1)
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  provider    String        // pagarme | asaas | stripe
  providerRef String?
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int
  installments Int          @default(1)
  pixQrCode   String?
  pixExpiresAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
}

model Shipment {
  id          String         @id @default(cuid())
  orderId     String         @unique
  order       Order          @relation(fields: [orderId], references: [id])
  provider    String         // melhorenvio
  providerRef String?
  carrier     String?
  service     String?
  labelUrl    String?
  trackingCode String?
  status      ShipmentStatus @default(LABEL_CREATED)
  labelCreatedAt DateTime    @default(now())
  scannedAt   DateTime?      // "Shipped" = scan, não etiqueta
  deliveredAt DateTime?
  weightGrams Int
  costCents   Int
}

model LedgerEntry {
  id        String     @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id])
  orderId   String?
  order     Order?     @relation(fields: [orderId], references: [id])
  type      LedgerType
  amountCents Int      // positivo = crédito ao seller, negativo = débito
  availableAt DateTime // quando sai de "processing" para "available"
  createdAt DateTime   @default(now())
  @@index([sellerId, availableAt])
}

model Event {
  id        String   @id @default(cuid())
  type      String   // auction.closed, order.paid, shipment.scanned, ...
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  payload   Json
  createdAt DateTime @default(now())
  @@index([type, createdAt])
}
